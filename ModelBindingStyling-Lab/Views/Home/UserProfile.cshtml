@model UserProfile

@{
    ViewData["Title"] = @Model.FullName + " profile page";
}

<h1>Profile Page</h1>

<div class="card mb-3" style="max-width: 540px;">
    <div class="row g-0">
        <div class="col-md-4">
            <img src="@Model.ImageUrl" class="img-fluid rounded-circle" style="width:200px; height:200px; object-fit:cover" alt="@Model.FullName 's Profile Photo">
        </div>
        <div class="col-md-8">
            <div class="card-body">
                <h2 class="card-title">@Model.FullName</h2>
                <p class="card-text">
                    <strong>UserProfileID:</strong> @Model.UserProfileId <br />
                    <strong>Email Address:</strong> <a href="@Model.Email">@Model.Email</a> <br />
                    <strong>Phone Number:</strong> @Model.PhoneNumber <br />
                    <strong>GitHub URL:</strong> <a href="@Model.GitHubUrl">@Model.GitHubUrl</a> <br />
                    <div class="d-flex align-items-center gap-3">
                        <strong>Skilled Languages:</strong>

                        <div class="d-flex gap-2">
                        <ul class="list-group list-group-horizontal">
                            @foreach (string languageSkill in Model.SkilledLanguages)
                            {
                                <li class="badge list-group-item rounded-pill text-bg-primary">@languageSkill</li>
                            }
                        </ul>
                        </div>
                    </div>

                </p>
            </div>
        </div>
    </div>
</div>
